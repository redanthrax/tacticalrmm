# Optimized Dockerfile for faster startup times
# pulls community scripts from git repo
FROM python:3.11.8-slim AS GET_SCRIPTS_STAGE

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    git clone https://github.com/amidaware/community-scripts.git /community-scripts && \
    apt-get purge -y git && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

FROM python:3.11.8-slim

ENV TACTICAL_DIR /opt/tactical
ENV TACTICAL_READY_FILE ${TACTICAL_DIR}/tmp/tactical.ready
ENV WORKSPACE_DIR /workspace
ENV TACTICAL_USER tactical
ENV VIRTUAL_ENV ${WORKSPACE_DIR}/api/tacticalrmm/env
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

EXPOSE 8000 8383 8005

# Install system dependencies in one layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        weasyprint \
        libpq-dev \
        pkg-config \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create user early
RUN groupadd -g 1000 tactical && \
    useradd -u 1000 -g 1000 tactical

# Copy community scripts
COPY --from=GET_SCRIPTS_STAGE /community-scripts /community-scripts

# Copy requirements first for better layer caching
COPY .devcontainer/requirements.txt /requirements.txt
COPY api/tacticalrmm/requirements.txt /base-requirements.txt
COPY api/tacticalrmm/requirements-dev.txt /dev-requirements.txt
COPY api/tacticalrmm/requirements-test.txt /test-requirements.txt

# Create virtual environment and install dependencies in separate layers
RUN python -m venv ${WORKSPACE_DIR}/api/tacticalrmm/env

# Install pip, setuptools, wheel first
RUN ${WORKSPACE_DIR}/api/tacticalrmm/env/bin/python -m pip install --upgrade pip setuptools wheel

# Install base requirements
RUN ${WORKSPACE_DIR}/api/tacticalrmm/env/bin/pip install --no-cache-dir -r /base-requirements.txt

# Install dev requirements
RUN ${WORKSPACE_DIR}/api/tacticalrmm/env/bin/pip install --no-cache-dir -r /dev-requirements.txt

# Install test requirements
RUN ${WORKSPACE_DIR}/api/tacticalrmm/env/bin/pip install --no-cache-dir -r /test-requirements.txt

# Copy docker entrypoint.sh
COPY .devcontainer/entrypoint.sh /
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

WORKDIR ${WORKSPACE_DIR}/api/tacticalrmm
